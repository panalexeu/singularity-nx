From 655715431a92559c78b8a7d490c45ba249751277 Mon Sep 17 00:00:00 2001
From: Oleksii Horchynskyi <pan.alexeu@gmail.com>
Date: Sat, 14 Nov 2026 09:56:25 +0200
Subject: [PATCH] deko3d: each shader's prepared info (SPIR-V fingerprint,
 specialization mask, interpolators) kept in cache/info_shaders.bin

A pixel shader's first draw converted its whole SPIR-V to GLSL only to learn which interpolators it reads, 5-10 ms
each on the ring thread, every session: Singularity's lightning (~150 new shaders in one frame) froze for 0.3-0.8 s
after the card reads were gone. The results are saved and loaded by container fingerprint (the PC can write the
file for a whole library: singularity-nx's ds_info). Loading a compiled shader into memory is timed with them.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CGstJFihyJYNUGR3QC7gUu
---
 include/rex/x360/deko/render.h |  5 ++++
 src/x360/deko/destinos.cpp     | 50 ++++++++++++++++++++++++++++++++--
 src/x360/deko/dibujos.cpp      | 17 +++++++++++-
 3 files changed, 69 insertions(+), 3 deletions(-)

diff --git a/include/rex/x360/deko/render.h b/include/rex/x360/deko/render.h
index ec2295a..b5ab122 100644
--- a/include/rex/x360/deko/render.h
+++ b/include/rex/x360/deko/render.h
@@ -464,6 +464,11 @@ class RenderDk final : public DestinosNativos {
     bool interpoladores_listos = false;
   };
   InfoShader& InfoDe(const EntradaShader& entrada);
+  // InfoDe's results from earlier sessions, by container fingerprint (cache/info_shaders.bin): a pixel shader's first
+  // use converted its whole SPIR-V to GLSL only to learn its interpolators, ~5-10 ms each on the ring thread (most of
+  // the lightning freeze once the reads were gone). info_sucia_: new entries since the last save.
+  std::unordered_map<uint64_t, InfoShader> info_guardada_;
+  bool info_sucia_ = false;
   void RecogerCompilaciones();
 
   // ---- Textures, samplers and descriptors (nfsmw_dk_texturas.cpp)
diff --git a/src/x360/deko/destinos.cpp b/src/x360/deko/destinos.cpp
index 52f5868..e8fd269 100644
--- a/src/x360/deko/destinos.cpp
+++ b/src/x360/deko/destinos.cpp
@@ -190,6 +190,8 @@ DkImageView VistaCompleta(const DkImage& imagen) {
 std::filesystem::path RutaCache() { return rex::filesystem::GetExecutableFolder() / "cache" / "nfsmw_dksh.bin"; }
 std::filesystem::path RutaUsados() { return rex::filesystem::GetExecutableFolder() / "cache" / "usados_dksh.bin"; }
 constexpr uint32_t kMagiaUsados = 0x5355444B;  // "KDUS": the used variants (RenderDk::usados_)
+std::filesystem::path RutaInfo() { return rex::filesystem::GetExecutableFolder() / "cache" / "info_shaders.bin"; }
+constexpr uint32_t kMagiaInfo = 0x4F464E49;  // "INFO": RenderDk::info_guardada_
 
 // ---- The output pass's shaders (GLSL for uam). The same work as the Vulkan path's nfsmw_salida_rampa_gamma.frag
 // (see it for the reasons): a full-screen triangle, the source's texel, and the game's ramp.
@@ -533,6 +535,25 @@ RenderDk::RenderDk(deko::ProveedorDeko3d& proveedor, rex::memory::Memory* memori
     }
     std::fclose(f);
   }
+  if (std::FILE* f = std::fopen(RutaInfo().string().c_str(), "rb")) {
+    uint32_t cabecera[2] = {};
+    if (std::fread(cabecera, sizeof(cabecera), 1, f) == 1 && cabecera[0] == kMagiaInfo && cabecera[1] <= 200000) {
+      for (uint32_t i = 0; i < cabecera[1]; ++i) {
+        uint64_t clave = 0;
+        InfoShader info;
+        uint8_t listos = 0;
+        if (std::fread(&clave, 8, 1, f) != 1 || std::fread(&info.huella, 8, 1, f) != 1 ||
+            std::fread(&info.mascara, 4, 1, f) != 1 || std::fread(&info.interpoladores, 4, 1, f) != 1 ||
+            std::fread(&listos, 1, 1, f) != 1) {
+          break;
+        }
+        info.interpoladores_listos = listos != 0;
+        info_guardada_[clave] = info;
+      }
+    }
+    std::fclose(f);
+    REXLOG_INFO("[deko3d] {} shaders ya preparados en sesiones anteriores", info_guardada_.size());
+  }
   if (!usados_.empty()) {
     precarga_ = std::thread([this, lista = usados_] {
       const uint64_t inicio = deko::AhoraNs();
@@ -2384,13 +2405,38 @@ void RenderDk::AnotarUsado(const deko::CacheDksh::Clave& clave) {
 
 void RenderDk::GuardarUsadosSiHaceFalta(bool ya) {
   const uint64_t ahora = deko::AhoraNs();
-  if (!usados_sucios_ || (!ya && ahora - usados_guardados_ns_ < 30'000'000'000ull)) {
+  if (!(usados_sucios_ || info_sucia_) || (!ya && ahora - usados_guardados_ns_ < 30'000'000'000ull)) {
     return;
   }
-  usados_sucios_ = false;
   usados_guardados_ns_ = ahora;
   std::error_code error;
   std::filesystem::create_directories(RutaUsados().parent_path(), error);
+  if (info_sucia_) {
+    info_sucia_ = false;
+    const std::string temporal_info = RutaInfo().string() + ".tmp";
+    if (std::FILE* f = std::fopen(temporal_info.c_str(), "wb")) {
+      const uint32_t cabecera[2] = {kMagiaInfo, uint32_t(info_guardada_.size())};
+      bool ok = std::fwrite(cabecera, sizeof(cabecera), 1, f) == 1;
+      for (const auto& [clave, info] : info_guardada_) {
+        const uint8_t listos = info.interpoladores_listos ? 1 : 0;
+        ok = ok && std::fwrite(&clave, 8, 1, f) == 1 && std::fwrite(&info.huella, 8, 1, f) == 1 &&
+             std::fwrite(&info.mascara, 4, 1, f) == 1 && std::fwrite(&info.interpoladores, 4, 1, f) == 1 &&
+             std::fwrite(&listos, 1, 1, f) == 1;
+      }
+      ok = std::fclose(f) == 0 && ok;
+      if (ok) {
+        std::filesystem::rename(temporal_info, RutaInfo(), error);
+        if (error) {
+          std::filesystem::remove(RutaInfo(), error);
+          std::filesystem::rename(temporal_info, RutaInfo(), error);
+        }
+      }
+    }
+  }
+  if (!usados_sucios_) {
+    return;
+  }
+  usados_sucios_ = false;
   const std::string temporal = RutaUsados().string() + ".tmp";
   if (std::FILE* f = std::fopen(temporal.c_str(), "wb")) {
     const uint32_t cabecera[2] = {kMagiaUsados, uint32_t(usados_.size())};
diff --git a/src/x360/deko/dibujos.cpp b/src/x360/deko/dibujos.cpp
index 4cb8ff0..8db19b1 100644
--- a/src/x360/deko/dibujos.cpp
+++ b/src/x360/deko/dibujos.cpp
@@ -902,6 +902,14 @@ RenderDk::InfoShader& RenderDk::InfoDe(const EntradaShader& entrada) {
   if (info.huella && (entrada.vertices || info.interpoladores_listos)) {
     return info;
   }
+  // Prepared in an earlier session: the same container gives the same SPIR-V, so the same results.
+  if (entrada.huella_contenedor) {
+    if (const auto it = info_guardada_.find(entrada.huella_contenedor);
+        it != info_guardada_.end() && it->second.huella && (entrada.vertices || it->second.interpoladores_listos)) {
+      info = it->second;
+      return info;
+    }
+  }
   const uint64_t inicio_info = deko::AhoraNs();
   struct Medir {
     std::atomic<uint64_t>& ns;
@@ -918,6 +926,10 @@ RenderDk::InfoShader& RenderDk::InfoDe(const EntradaShader& entrada) {
     info.interpoladores = deko::SpirvAGlsl(entrada.spirv, 0).interpoladores;
     info.interpoladores_listos = true;
   }
+  if (entrada.huella_contenedor && info.huella && !entrada.spirv.empty()) {
+    info_guardada_[entrada.huella_contenedor] = info;
+    info_sucia_ = true;
+  }
   return info;
 }
 
@@ -972,7 +984,10 @@ const DkShader* RenderDk::ShaderDe(const EntradaShader& entrada, uint32_t especi
   if (const std::vector<uint8_t>* dksh = cache_.Buscar(clave_cache)) {
     ++aciertos_cache_;
     AnotarUsado(clave_cache);
-    return cargar(*dksh);
+    const uint64_t inicio_carga = deko::AhoraNs();
+    const DkShader* cargado = cargar(*dksh);
+    info_ns_.fetch_add(deko::AhoraNs() - inicio_carga, std::memory_order_relaxed);  // a first-time cost too
+    return cargado;
   }
   static const bool en_fondo = REXCVAR_GET(nfsmw_dk_compilar_en_fondo);
   if (entrada.vertices && variante != kTodasLasSalidas && en_fondo &&
-- 
