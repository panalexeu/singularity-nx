 src/audio/xma_decoder.cpp     |  9 +++++++++
 src/core/threading_switch.cpp | 26 ++++++++++++++++++++++++++
 src/core/threading_switch.h   |  9 +++++++++
 4 files changed, 53 insertions(+)

diff --git a/src/audio/audio_system.cpp b/src/audio/audio_system.cpp
