 REXCVAR_DEFINE_INT32(
     audio_maxqframes, 8, "Audio",
@@ -119,7 +122,13 @@ void AudioSystem::WorkerThreadMain() {
 
   // Main run loop.
   uint32_t diag_pump_count = 0;
+#if REX_PLATFORM_SWITCH
+  int nucleo_aplicado = -1;
+#endif
   while (worker_running_) {
+#if REX_PLATFORM_SWITCH
