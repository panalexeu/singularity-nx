+++ b/src/x360/deko/dibujos.cpp
@@ -899,6 +899,23 @@ void RenderDk::CerrarFotogramaDeLaGuardiaDelCielo() {
 
 RenderDk::InfoShader& RenderDk::InfoDe(const EntradaShader& entrada) {
   InfoShader& info = info_shaders_[&entrada];
+  if (info.huella && (entrada.vertices || info.interpoladores_listos)) {
+    return info;
+  }
+  // Prepared in an earlier session: the same container gives the same SPIR-V, so the same results.
+  if (entrada.huella_contenedor) {
+    if (const auto it = info_guardada_.find(entrada.huella_contenedor);
+        it != info_guardada_.end() && it->second.huella && (entrada.vertices || it->second.interpoladores_listos)) {
+      info = it->second;
+      return info;
+    }
+  }
+  const uint64_t inicio_info = deko::AhoraNs();
+  struct Medir {
+    std::atomic<uint64_t>& ns;
+    uint64_t inicio;
+    ~Medir() { ns.fetch_add(deko::AhoraNs() - inicio, std::memory_order_relaxed); }
+  } medir{info_ns_, inicio_info};
   if (!info.huella) {
     const auto& espirv = entrada.spirv;
     info.huella = deko::HuellaSpirv(espirv);
@@ -909,6 +926,10 @@ RenderDk::InfoShader& RenderDk::InfoDe(const EntradaShader& entrada) {
     info.interpoladores = deko::SpirvAGlsl(entrada.spirv, 0).interpoladores;
     info.interpoladores_listos = true;
   }
+  if (entrada.huella_contenedor && info.huella && !entrada.spirv.empty()) {
+    info_guardada_[entrada.huella_contenedor] = info;
+    info_sucia_ = true;
+  }
   return info;
 }
 
@@ -962,7 +983,10 @@ const DkShader* RenderDk::ShaderDe(const EntradaShader& entrada, uint32_t especi
   };
   if (const std::vector<uint8_t>* dksh = cache_.Buscar(clave_cache)) {
     ++aciertos_cache_;
-    return cargar(*dksh);
+    const uint64_t inicio_carga = deko::AhoraNs();
+    const DkShader* cargado = cargar(*dksh);
+    info_ns_.fetch_add(deko::AhoraNs() - inicio_carga, std::memory_order_relaxed);  // a first-time cost too
+    return cargado;
   }
   static const bool en_fondo = REXCVAR_GET(nfsmw_dk_compilar_en_fondo);
   if (entrada.vertices && variante != kTodasLasSalidas && en_fondo &&
