+constexpr uint32_t kMagiaInfo = 0x4F464E49;  // "INFO": RenderDk::info_guardada_
 
 // ---- The output pass's shaders (GLSL for uam). The same work as the Vulkan path's nfsmw_salida_rampa_gamma.frag
 // (see it for the reasons): a full-screen triangle, the source's texel, and the game's ramp.
@@ -515,6 +517,25 @@ RenderDk::RenderDk(deko::ProveedorDeko3d& proveedor, rex::memory::Memory* memori
   if (!cache_.size()) {
     REXLOG_WARN("[deko3d] sin cache de DKSH: cada shader se compila en la consola la primera vez que se usa");
   }
+  if (std::FILE* f = std::fopen(RutaInfo().string().c_str(), "rb")) {
+    uint32_t cabecera[2] = {};
+    if (std::fread(cabecera, sizeof(cabecera), 1, f) == 1 && cabecera[0] == kMagiaInfo && cabecera[1] <= 200000) {
+      for (uint32_t i = 0; i < cabecera[1]; ++i) {
+        uint64_t clave = 0;
+        InfoShader info;
+        uint8_t listos = 0;
+        if (std::fread(&clave, 8, 1, f) != 1 || std::fread(&info.huella, 8, 1, f) != 1 ||
+            std::fread(&info.mascara, 4, 1, f) != 1 || std::fread(&info.interpoladores, 4, 1, f) != 1 ||
+            std::fread(&listos, 1, 1, f) != 1) {
+          break;
+        }
+        info.interpoladores_listos = listos != 0;
+        info_guardada_[clave] = info;
+      }
+    }
+    std::fclose(f);
+    REXLOG_INFO("[deko3d] {} shaders ya preparados en sesiones anteriores", info_guardada_.size());
+  }
   cache_guardada_ns_ = deko::AhoraNs();
 
   const deko::Compilador::Resultado vacio = compilador_.Compilar(false, "#version 460\nvoid main() {}\n");
@@ -538,6 +559,7 @@ RenderDk::~RenderDk() {
   }
   nucleo_.EsperarGpu();
   GuardarCacheSiHaceFalta(true);
+  GuardarInfoSiHaceFalta(true);
   if (guardando_.joinable()) {
     guardando_.join();
   }
@@ -2328,10 +2350,48 @@ bool RenderDk::Presentar(rex::ui::Presenter* presentador, const TexturaSwap& swa
   CerrarFotogramaDeLaGuardiaDelCielo();
   SoltarTexturasSiHaceFalta();
   GuardarCacheSiHaceFalta(false);
+  GuardarInfoSiHaceFalta(false);
   InformePeriodico();
   return pintado;
 }
 
+// ---- Each shader's info (InfoDe), kept for the next sessions
+
+void RenderDk::GuardarInfoSiHaceFalta(bool ya) {
+  const uint64_t ahora = deko::AhoraNs();
+  if (!info_sucia_ || (!ya && ahora - info_guardada_ns_ < 30'000'000'000ull)) {
+    return;
+  }
+  info_guardada_ns_ = ahora;
+  info_sucia_ = false;
+  std::error_code error;
+  std::filesystem::create_directories(RutaInfo().parent_path(), error);
+  const std::string temporal = RutaInfo().string() + ".tmp";
+  if (std::FILE* f = std::fopen(temporal.c_str(), "wb")) {
+    const uint32_t cabecera[2] = {kMagiaInfo, uint32_t(info_guardada_.size())};
+    bool ok = std::fwrite(cabecera, sizeof(cabecera), 1, f) == 1;
+    for (const auto& [clave, info] : info_guardada_) {
+      const uint8_t listos = info.interpoladores_listos ? 1 : 0;
+      ok = ok && std::fwrite(&clave, 8, 1, f) == 1 && std::fwrite(&info.huella, 8, 1, f) == 1 &&
+           std::fwrite(&info.mascara, 4, 1, f) == 1 && std::fwrite(&info.interpoladores, 4, 1, f) == 1 &&
+           std::fwrite(&listos, 1, 1, f) == 1;
+    }
+    ok = std::fclose(f) == 0 && ok;
+    if (ok) {
+      std::filesystem::rename(temporal, RutaInfo(), error);
+      if (error) {
+        std::filesystem::remove(RutaInfo(), error);
+        std::filesystem::rename(temporal, RutaInfo(), error);
+      }
+    }
+  }
+}
+
+void RenderDk::PrimerosUsos(uint64_t& lecturas, uint64_t& nanosegundos) const {
+  lecturas = cache_.lecturas();
+  nanosegundos = cache_.lecturas_ns() + info_ns_.load(std::memory_order_relaxed);
+}
+
 // ---- The DKSH cache file and the report
 
 void RenderDk::GuardarCacheSiHaceFalta(bool ya) {
diff --git a/src/x360/deko/dibujos.cpp b/src/x360/deko/dibujos.cpp
index b4d3914..cabb2dc 100644
