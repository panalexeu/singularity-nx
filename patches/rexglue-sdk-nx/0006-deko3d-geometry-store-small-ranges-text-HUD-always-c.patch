From 8ffe9b224aa8bf5f523e9d7e276af98ce639ce50 Mon Sep 17 00:00:00 2001
From: Oleksii Horchynskyi <pan.alexeu@gmail.com>
Date: Mon, 9 Nov 2026 18:39:09 +0200
Subject: [PATCH] deko3d geometry store: small ranges (text, HUD) always
 checked whole, never trusted or sampled

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CGstJFihyJYNUGR3QC7gUu
---
 src/x360/deko/geometria.cpp | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/src/x360/deko/geometria.cpp b/src/x360/deko/geometria.cpp
index 66a469b..b17a893 100644
--- a/src/x360/deko/geometria.cpp
+++ b/src/x360/deko/geometria.cpp
@@ -12,6 +12,11 @@
 #include <rex/ui/deko3d/nucleo.h>
 #include <rex/cvar.h>
 
+REXCVAR_DEFINE_INT32(nfsmw_dk_geometria_exacta_bytes, 16384, "Deko3d",
+                     "deko3d: vertex and index ranges up to this many bytes are always checked whole, every frame "
+                     "(neither trusted 1 frame in nfsmw_dk_geometria_confianza nor sampled): text and HUD quads, "
+                     "rewritten in place, showed some glyphs old for a few frames. Cheap at that size. 0 = off")
+    .range(0, 1 << 20);
 REXCVAR_DEFINE_INT32(nfsmw_dk_geometria_confianza, 4, "NFSMW",
                      "deko3d: un rango de vertices que salio igual 16 comprobaciones seguidas solo se vuelve a comprobar 1 "
                      "de cada N fotogramas (el resto se usa el bloque guardado). 1 = comprobar siempre, como antes. "
@@ -224,7 +229,9 @@ AlmacenGeometria::Resultado AlmacenGeometria::Consultar(const uint8_t* datos, ui
   // A range found unchanged 16 times in a row is trusted for confianza - 1 frames out of confianza (a range the game
   // rewrites in place shows its old content for at most that long; ranges that change go to the ring as volatile).
   static const uint32_t confianza = uint32_t(REXCVAR_GET(nfsmw_dk_geometria_confianza));
-  if (e.tam && confianza > 1 && e.confirmadas >= 16 && (fotograma_ + (e.datos >> 6)) % confianza != 0) {
+  static const uint32_t exacta = uint32_t(REXCVAR_GET(nfsmw_dk_geometria_exacta_bytes));
+  const bool pequeno = bytes <= exacta;  // checked whole every frame (nfsmw_dk_geometria_exacta_bytes)
+  if (!pequeno && e.tam && confianza > 1 && e.confirmadas >= 16 && (fotograma_ + (e.datos >> 6)) % confianza != 0) {
     ++estadisticas_.aciertos;
     estadisticas_.bytes_aciertos += bytes;
     return {&e, gpu_ + e.offset, e.vmin, e.vmax};
@@ -232,7 +239,7 @@ AlmacenGeometria::Resultado AlmacenGeometria::Consultar(const uint8_t* datos, ui
   // A stored range with its phase hashes: one eighth of its lines (rotating, so every line is read at least once
   // every kFases frames) plus the first and the last. The guard: the first kMuestrasGuardia sampled checks also hash
   // everything, and one disagreement switches sampling off.
-  if (e.tam && e.fases_validas && muestreo_) {
+  if (!pequeno && e.tam && e.fases_validas && muestreo_) {
     // Per entry, not from the frame: with checks only 1 frame in confianza, a frame-based phase would read only some
     // of the phases.
     const uint32_t fase = e.fase;
-- 
2.43.0

