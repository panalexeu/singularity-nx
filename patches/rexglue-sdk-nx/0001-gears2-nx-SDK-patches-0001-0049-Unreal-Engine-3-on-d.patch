+const ImagenDk* RenderDk::ResueltaConSigno(const ImagenDk& resuelta, uint32_t signos) {
+  // Per host channel: the guest's X..W are R..A, or B, G, R, A with the red/blue swap of the resolve.
+  int32_t modos[4] = {};
