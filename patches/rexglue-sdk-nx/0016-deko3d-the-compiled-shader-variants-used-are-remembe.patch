From 3aefb0c6e13ecefd9b99867b6f54da6432a04505 Mon Sep 17 00:00:00 2001
From: Oleksii Horchynskyi <pan.alexeu@gmail.com>
Date: Sat, 14 Nov 2026 09:42:09 +0200
Subject: [PATCH] deko3d: the compiled shader variants used are remembered and
 read ahead at the next start; first-use reads counted

cache/usados_dksh.bin (at most 1500 variants, oldest dropped). A scene that suddenly needed many shaders it had not
drawn yet (Singularity's lightning) read each compiled shader from the 577 MB cache file on the ring thread at its first
draw. PrimerosUsos tells how many such reads (and InfoDe's first-time work) a long frame had.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CGstJFihyJYNUGR3QC7gUu
---
 include/rex/ui/deko3d/cache_dksh.h |  5 ++
 include/rex/x360/deko/render.h     | 14 +++++
 include/rex/x360/destinos.h        |  6 +++
 src/ui/deko3d/cache_dksh.cpp       |  6 +++
 src/x360/deko/destinos.cpp         | 83 ++++++++++++++++++++++++++++++
 src/x360/deko/dibujos.cpp          | 10 ++++
 6 files changed, 124 insertions(+)

diff --git a/include/rex/ui/deko3d/cache_dksh.h b/include/rex/ui/deko3d/cache_dksh.h
index 0cc6e9e..d253a53 100644
--- a/include/rex/ui/deko3d/cache_dksh.h
+++ b/include/rex/ui/deko3d/cache_dksh.h
@@ -24,6 +24,7 @@
 #include <cstdio>
 #include <filesystem>
 #include <map>
+#include <atomic>
 #include <mutex>
 #include <span>
 #include <string>
@@ -59,6 +60,9 @@ class CacheDksh {
   const std::vector<uint8_t>* Buscar(const Clave& clave) const;
   void Anadir(const Clave& clave, std::vector<uint8_t> dksh);
   size_t size() const { return entradas_.size() + indice_.size(); }
+  // Entries read from the file so far (CargarIndice), and the time it took: the first use of each one.
+  uint64_t lecturas() const { return lecturas_.load(std::memory_order_relaxed); }
+  uint64_t lecturas_ns() const { return lecturas_ns_.load(std::memory_order_relaxed); }
   const std::map<Clave, std::vector<uint8_t>>& entradas() const { return entradas_; }
   // Takes the entries out (the cache is left empty): merging a large cache into another without copying it.
   std::map<Clave, std::vector<uint8_t>> Extraer() { return std::move(entradas_); }
@@ -75,6 +79,7 @@ class CacheDksh {
   std::filesystem::path ruta_;
   mutable std::FILE* archivo_ = nullptr;
   mutable std::mutex mutex_;
+  mutable std::atomic<uint64_t> lecturas_{0}, lecturas_ns_{0};
 
  public:
   CacheDksh() = default;
diff --git a/include/rex/x360/deko/render.h b/include/rex/x360/deko/render.h
index c7f0cb1..ec2295a 100644
--- a/include/rex/x360/deko/render.h
+++ b/include/rex/x360/deko/render.h
@@ -183,6 +183,7 @@ class RenderDk final : public DestinosNativos {
   bool Dibujar(const PeticionDibujo& peticion) override;  // nfsmw_dk_dibujos.cpp
   void PedirVolcado() override { volcado_pedido_ = true; }
   bool FusionarProfundidadPosterior() override;
+  void PrimerosUsos(uint64_t& lecturas, uint64_t& nanosegundos) const override;
   EstadisticasDibujos EstadisticasDeDibujos() const override;
   void EsperarSubidas() override {}  // vertices are copied on the ring thread, before Dibujar returns
   uint64_t CopiasProfundidad() const override { return copias_profundidad_; }
@@ -635,6 +636,19 @@ class RenderDk final : public DestinosNativos {
   deko::CacheDksh cache_consola_;
   bool cache_sucia_ = false;
   std::thread guardando_;  // writes the cache file (GuardarCacheSiHaceFalta)
+  // The compiled variants used (cache hits), oldest first, at most kUsadosMax: saved beside the console's cache and read
+  // ahead at the next start on precarga_, so a scene's first draws with them (a lightning flash) do not wait for the
+  // card. usados_sucios_: changed since the last save.
+  static constexpr size_t kUsadosMax = 1500;
+  std::vector<deko::CacheDksh::Clave> usados_;
+  std::set<deko::CacheDksh::Clave> usados_vistos_;
+  bool usados_sucios_ = false;
+  uint64_t usados_guardados_ns_ = 0;
+  std::thread precarga_;
+  std::atomic<bool> precarga_parar_{false};
+  std::atomic<uint64_t> info_ns_{0};  // InfoDe's first-time work (SPIR-V to GLSL for the interpolators)
+  void AnotarUsado(const deko::CacheDksh::Clave& clave);
+  void GuardarUsadosSiHaceFalta(bool ya);
   uint64_t cache_guardada_ns_ = 0;
   uint32_t compilados_en_el_acto_ = 0, compilados_en_fondo_ = 0, aciertos_cache_ = 0;
   // Background compiles (the exact vertex shader variant, while the one with every interpolator draws). The
diff --git a/include/rex/x360/destinos.h b/include/rex/x360/destinos.h
index 3b37907..4847b19 100644
--- a/include/rex/x360/destinos.h
+++ b/include/rex/x360/destinos.h
@@ -121,6 +121,12 @@ class DestinosNativos {
   // larger value): what was drawn there after the resolve (a first-person weapon after its own depth clear) reaches
   // the post-processing that samples the texture. false if there was nothing to merge.
   virtual bool FusionarProfundidadPosterior() { return false; }
+  // First uses so far: compiled shaders read from the card, and the time spent (reading them and preparing each shader
+  // the first time). For telling whether a long frame was waiting for shaders.
+  virtual void PrimerosUsos(uint64_t& lecturas, uint64_t& nanosegundos) const {
+    lecturas = 0;
+    nanosegundos = 0;
+  }
   virtual EstadisticasDibujos EstadisticasDeDibujos() const = 0;
   // Deferred vertex copies finished: before returning the read pointer to the game.
   virtual void EsperarSubidas() = 0;
diff --git a/src/ui/deko3d/cache_dksh.cpp b/src/ui/deko3d/cache_dksh.cpp
index 8eb21fb..2160f12 100644
--- a/src/ui/deko3d/cache_dksh.cpp
+++ b/src/ui/deko3d/cache_dksh.cpp
@@ -1,5 +1,6 @@
 // rex::deko3d (from nfsmw-nx): the DKSH cache file. See rex/ui/deko3d/cache_dksh.h.
 
+#include <chrono>
 #include <rex/ui/deko3d/cache_dksh.h>
 
 #include <rex/ui/deko3d/glsl.h>
@@ -180,11 +181,16 @@ const std::vector<uint8_t>* CacheDksh::Buscar(const Clave& clave) const {
   if (it == indice_.end() || it->clave != clave || !archivo_) {
     return nullptr;
   }
+  const auto inicio = std::chrono::steady_clock::now();
   std::vector<uint8_t> dksh(it->bytes);
   if (std::fseek(archivo_, long(it->posicion), SEEK_SET) != 0 ||
       std::fread(dksh.data(), 1, dksh.size(), archivo_) != dksh.size()) {
     return nullptr;
   }
+  lecturas_.fetch_add(1, std::memory_order_relaxed);
+  lecturas_ns_.fetch_add(uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                      std::chrono::steady_clock::now() - inicio).count()),
+                         std::memory_order_relaxed);
   return &entradas_.emplace(clave, std::move(dksh)).first->second;
 }
 
diff --git a/src/x360/deko/destinos.cpp b/src/x360/deko/destinos.cpp
index 65e0421..52f5868 100644
--- a/src/x360/deko/destinos.cpp
+++ b/src/x360/deko/destinos.cpp
@@ -188,6 +188,8 @@ DkImageView VistaCompleta(const DkImage& imagen) {
 }
 
 std::filesystem::path RutaCache() { return rex::filesystem::GetExecutableFolder() / "cache" / "nfsmw_dksh.bin"; }
+std::filesystem::path RutaUsados() { return rex::filesystem::GetExecutableFolder() / "cache" / "usados_dksh.bin"; }
+constexpr uint32_t kMagiaUsados = 0x5355444B;  // "KDUS": the used variants (RenderDk::usados_)
 
 // ---- The output pass's shaders (GLSL for uam). The same work as the Vulkan path's nfsmw_salida_rampa_gamma.frag
 // (see it for the reasons): a full-screen triangle, the source's texel, and the game's ramp.
@@ -515,6 +517,34 @@ RenderDk::RenderDk(deko::ProveedorDeko3d& proveedor, rex::memory::Memory* memori
   if (!cache_.size()) {
     REXLOG_WARN("[deko3d] sin cache de DKSH: cada shader se compila en la consola la primera vez que se usa");
   }
+  // The variants used in earlier sessions, read ahead from the card on a thread of their own: the first draws with each
+  // of them (a scene that suddenly needs many new shaders, as a lightning flash) no longer wait for the card.
+  if (std::FILE* f = std::fopen(RutaUsados().string().c_str(), "rb")) {
+    uint32_t cabecera[2] = {};
+    if (std::fread(cabecera, sizeof(cabecera), 1, f) == 1 && cabecera[0] == kMagiaUsados && cabecera[1] <= kUsadosMax) {
+      for (uint32_t i = 0; i < cabecera[1]; ++i) {
+        deko::CacheDksh::Clave c;
+        if (std::fread(&c.huella, 8, 1, f) != 1 || std::fread(&c.especializacion, 4, 1, f) != 1 ||
+            std::fread(&c.variante, 4, 1, f) != 1) {
+          break;
+        }
+        if (usados_vistos_.insert(c).second) usados_.push_back(c);
+      }
+    }
+    std::fclose(f);
+  }
+  if (!usados_.empty()) {
+    precarga_ = std::thread([this, lista = usados_] {
+      const uint64_t inicio = deko::AhoraNs();
+      size_t leidas = 0;
+      for (const deko::CacheDksh::Clave& c : lista) {
+        if (precarga_parar_.load(std::memory_order_relaxed)) break;
+        leidas += cache_.Buscar(c) != nullptr;
+      }
+      REXLOG_INFO("[deko3d] {} variantes de shaders usadas antes leidas por adelantado en {:.1f} s", leidas,
+                  double(deko::AhoraNs() - inicio) / 1e9);
+    });
+  }
   cache_guardada_ns_ = deko::AhoraNs();
 
   const deko::Compilador::Resultado vacio = compilador_.Compilar(false, "#version 460\nvoid main() {}\n");
@@ -538,9 +568,14 @@ RenderDk::~RenderDk() {
   }
   nucleo_.EsperarGpu();
   GuardarCacheSiHaceFalta(true);
+  GuardarUsadosSiHaceFalta(true);
   if (guardando_.joinable()) {
     guardando_.join();
   }
+  precarga_parar_.store(true, std::memory_order_relaxed);
+  if (precarga_.joinable()) {
+    precarga_.join();
+  }
   geometria_.Destruir();
   nucleo_.Destruir();
 }
@@ -2328,10 +2363,58 @@ bool RenderDk::Presentar(rex::ui::Presenter* presentador, const TexturaSwap& swa
   CerrarFotogramaDeLaGuardiaDelCielo();
   SoltarTexturasSiHaceFalta();
   GuardarCacheSiHaceFalta(false);
+  GuardarUsadosSiHaceFalta(false);
   InformePeriodico();
   return pintado;
 }
 
+// ---- The used variants (read ahead at the next start)
+
+void RenderDk::AnotarUsado(const deko::CacheDksh::Clave& clave) {
+  if (!usados_vistos_.insert(clave).second) {
+    return;
+  }
+  usados_.push_back(clave);
+  if (usados_.size() > kUsadosMax) {
+    usados_vistos_.erase(usados_.front());
+    usados_.erase(usados_.begin());
+  }
+  usados_sucios_ = true;
+}
+
+void RenderDk::GuardarUsadosSiHaceFalta(bool ya) {
+  const uint64_t ahora = deko::AhoraNs();
+  if (!usados_sucios_ || (!ya && ahora - usados_guardados_ns_ < 30'000'000'000ull)) {
+    return;
+  }
+  usados_sucios_ = false;
+  usados_guardados_ns_ = ahora;
+  std::error_code error;
+  std::filesystem::create_directories(RutaUsados().parent_path(), error);
+  const std::string temporal = RutaUsados().string() + ".tmp";
+  if (std::FILE* f = std::fopen(temporal.c_str(), "wb")) {
+    const uint32_t cabecera[2] = {kMagiaUsados, uint32_t(usados_.size())};
+    bool ok = std::fwrite(cabecera, sizeof(cabecera), 1, f) == 1;
+    for (const deko::CacheDksh::Clave& c : usados_) {
+      ok = ok && std::fwrite(&c.huella, 8, 1, f) == 1 && std::fwrite(&c.especializacion, 4, 1, f) == 1 &&
+           std::fwrite(&c.variante, 4, 1, f) == 1;
+    }
+    ok = std::fclose(f) == 0 && ok;
+    if (ok) {
+      std::filesystem::rename(temporal, RutaUsados(), error);
+      if (error) {
+        std::filesystem::remove(RutaUsados(), error);
+        std::filesystem::rename(temporal, RutaUsados(), error);
+      }
+    }
+  }
+}
+
+void RenderDk::PrimerosUsos(uint64_t& lecturas, uint64_t& nanosegundos) const {
+  lecturas = cache_.lecturas();
+  nanosegundos = cache_.lecturas_ns() + info_ns_.load(std::memory_order_relaxed);
+}
+
 // ---- The DKSH cache file and the report
 
 void RenderDk::GuardarCacheSiHaceFalta(bool ya) {
diff --git a/src/x360/deko/dibujos.cpp b/src/x360/deko/dibujos.cpp
index b4d3914..4cb8ff0 100644
--- a/src/x360/deko/dibujos.cpp
+++ b/src/x360/deko/dibujos.cpp
@@ -899,6 +899,15 @@ void RenderDk::CerrarFotogramaDeLaGuardiaDelCielo() {
 
 RenderDk::InfoShader& RenderDk::InfoDe(const EntradaShader& entrada) {
   InfoShader& info = info_shaders_[&entrada];
+  if (info.huella && (entrada.vertices || info.interpoladores_listos)) {
+    return info;
+  }
+  const uint64_t inicio_info = deko::AhoraNs();
+  struct Medir {
+    std::atomic<uint64_t>& ns;
+    uint64_t inicio;
+    ~Medir() { ns.fetch_add(deko::AhoraNs() - inicio, std::memory_order_relaxed); }
+  } medir{info_ns_, inicio_info};
   if (!info.huella) {
     const auto& espirv = entrada.spirv;
     info.huella = deko::HuellaSpirv(espirv);
@@ -962,6 +971,7 @@ const DkShader* RenderDk::ShaderDe(const EntradaShader& entrada, uint32_t especi
   };
   if (const std::vector<uint8_t>* dksh = cache_.Buscar(clave_cache)) {
     ++aciertos_cache_;
+    AnotarUsado(clave_cache);
     return cargar(*dksh);
   }
   static const bool en_fondo = REXCVAR_GET(nfsmw_dk_compilar_en_fondo);
