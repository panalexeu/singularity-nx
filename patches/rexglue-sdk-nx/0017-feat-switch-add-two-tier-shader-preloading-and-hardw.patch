+void RenderDk::PrecargarShaders(std::span<const EntradaShader* const> entradas) {
+  if (entradas.empty()) return;
+  const uint64_t inicio = deko::AhoraNs();
+  std::vector<uint64_t> huellas;
+  huellas.reserve(entradas.size());
+
+  for (const EntradaShader* e : entradas) {
+    if (!e || e->spirv.empty()) continue;
+    InfoShader& info = InfoDe(*e);
+    if (info.huella) {
+      huellas.push_back(info.huella);
+    }
+  }
+
+  cache_.PrecargarHuellas(huellas);
+
+  size_t preparados = 0;
+  for (const EntradaShader* e : entradas) {
+    if (!e || e->spirv.empty()) continue;
+    if (e->vertices) {
+      if (ShaderDe(*e, 0, kTodasLasSalidas, 0)) ++preparados;
+    } else {
+      if (ShaderDe(*e, 0, 0, 0)) ++preparados;
+    }
+  }
+
+  const double ms = double(deko::AhoraNs() - inicio) / 1e6;
+  REXLOG_INFO("[deko3d] precarga: {} shaders ({} preparados en GPU) en {:.1f} ms",
+              entradas.size(), preparados, ms);
+}
