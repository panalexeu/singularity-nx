+void CacheDksh::PrecargarHuellas(std::span<const uint64_t> huellas) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (!archivo_ || huellas.empty()) return;
+
+  std::vector<const EnArchivo*> por_leer;
+  for (uint64_t huella : huellas) {
+    Clave c_inicio{huella, 0, 0};
+    auto it = std::lower_bound(indice_.begin(), indice_.end(), c_inicio,
+                               [](const EnArchivo& a, const Clave& c) { return a.clave.huella < c.huella; });
+    for (; it != indice_.end() && it->clave.huella == huella; ++it) {
+      if (entradas_.find(it->clave) == entradas_.end()) {
+        por_leer.push_back(&*it);
+      }
+    }
+  }
+
+  if (por_leer.empty()) return;
+
+  std::sort(por_leer.begin(), por_leer.end(),
+            [](const EnArchivo* a, const EnArchivo* b) { return a->posicion < b->posicion; });
+
+  const auto inicio = std::chrono::steady_clock::now();
+  uint64_t leidas = 0;
+  for (const EnArchivo* e : por_leer) {
+    if (entradas_.find(e->clave) != entradas_.end()) continue;
+    std::vector<uint8_t> dksh(e->bytes);
+    if (std::fseek(archivo_, long(e->posicion), SEEK_SET) == 0 &&
+        std::fread(dksh.data(), 1, dksh.size(), archivo_) == dksh.size()) {
+      entradas_.emplace(e->clave, std::move(dksh));
+      ++leidas;
+    }
+  }
+  const auto dur = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - inicio).count();
+  lecturas_.fetch_add(leidas, std::memory_order_relaxed);
+  lecturas_ns_.fetch_add(uint64_t(dur), std::memory_order_relaxed);
+}
+
 }  // namespace rex::deko3d
