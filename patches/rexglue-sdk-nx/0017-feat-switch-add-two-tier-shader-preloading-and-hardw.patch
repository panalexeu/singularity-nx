   /*
    * With the debug overlay open, ZL+ZR and the right stick move it (debug_overlay.cpp,
    * on the UI thread). While ZL and ZR are held, the game sees neither those two
@@ -471,6 +611,19 @@ void SwitchInputDriver::DispatchMenuShortcuts(Slot& slot, uint64_t held) {
     REXLOG_INFO("atajo de menu: muestreo de pilas {}", activo ? "activo" : "apagado");
   }
   slot.menu_shortcuts = pilas_ahora ? (slot.menu_shortcuts | kBitPilas) : (slot.menu_shortcuts & ~kBitPilas);
+
+  // L + R + RStick toggles gyro aiming (0 <-> 2, or 1 -> 2)
+  constexpr uint64_t kToggleGyro = HidNpadButton_L | HidNpadButton_R | HidNpadButton_StickR;
+  const uint64_t kBitGyro = uint64_t(1) << 10;
+  const bool gyro_ahora = (held & kToggleGyro) == kToggleGyro;
+  const bool gyro_antes = (slot.menu_shortcuts & kBitGyro) != 0;
+  if (gyro_ahora && !gyro_antes) {
+    const int32_t current = REXCVAR_GET(input_gyro);
+    const int32_t nuevo = (current == 0) ? 2 : 0;
+    REXCVAR_SET(input_gyro, nuevo);
+    REXLOG_INFO("atajo de menu: punteria giroscopica {}", nuevo ? "ACTIVADA (siempre)" : "APAGADA");
+  }
+  slot.menu_shortcuts = gyro_ahora ? (slot.menu_shortcuts | kBitGyro) : (slot.menu_shortcuts & ~kBitGyro);
 }
 
