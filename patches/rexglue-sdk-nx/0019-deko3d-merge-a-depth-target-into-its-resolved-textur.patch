From 7877fde7913871469fb8e07d38775cbe4ab55d49 Mon Sep 17 00:00:00 2001
From: Oleksii Horchynskyi <pan.alexeu@gmail.com>
Date: Sun, 22 Nov 2026 16:52:23 +0200
Subject: [PATCH] deko3d: merge a depth target into its resolved texture again
 after a full clear and new draws (solo_tras_borrado)

A copy-path depth resolve whose target is then fully depth-cleared (the first-person weapon's pass) is marked; a
pass sampling the texture after new draws on the target can merge the target in (nearer wins) with
FusionarProfundidadEn(base, true), and the depth of field's merge repeats if something was drawn since. A clear after a
merge is the next frame's and stops following the texture until its next resolve.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/rex/x360/deko/render.h |  4 +++-
 include/rex/x360/destinos.h    | 10 ++++++++--
 src/x360/deko/destinos.cpp     | 19 ++++++++++++++++---
 3 files changed, 27 insertions(+), 6 deletions(-)

diff --git a/include/rex/x360/deko/render.h b/include/rex/x360/deko/render.h
index 179b202..456be3c 100644
--- a/include/rex/x360/deko/render.h
+++ b/include/rex/x360/deko/render.h
@@ -183,7 +183,7 @@ class RenderDk final : public DestinosNativos {
   bool Dibujar(const PeticionDibujo& peticion) override;  // nfsmw_dk_dibujos.cpp
   void PedirVolcado() override { volcado_pedido_ = true; }
   bool FusionarProfundidadPosterior() override;
-  int FusionarProfundidadEn(uint32_t base_textura) override;
+  int FusionarProfundidadEn(uint32_t base_textura, bool solo_tras_borrado = false) override;
   uint32_t UltimaResolucionProfundidad() const override { return ultima_z_valida_ ? ultima_z_textura_ : 0; }
   void PrecargarShaders(std::span<const EntradaShader* const> entradas) override;
   void PrimerosUsos(uint64_t& lecturas, uint64_t& nanosegundos) const override;
@@ -257,6 +257,8 @@ class RenderDk final : public DestinosNativos {
     uint32_t info = 0, pitch = 0;
     std::array<uint32_t, 6> rect{};
     bool pendiente = false;
+    bool borrada = false;  // the target was fully depth-cleared after the resolve: another pass draws on it now
+    uint64_t dibujos_fusion = UINT64_MAX;  // dibujados_ at the last merge
   };
   std::unordered_map<uint32_t, ZResuelta> z_resueltas_;
   bool FusionarDesde(uint32_t info, uint32_t pitch, uint32_t base, const std::array<uint32_t, 6>& r, int& motivo);
diff --git a/include/rex/x360/destinos.h b/include/rex/x360/destinos.h
index 1fc190f..5a9dda8 100644
--- a/include/rex/x360/destinos.h
+++ b/include/rex/x360/destinos.h
@@ -123,10 +123,16 @@ class DestinosNativos {
   virtual bool FusionarProfundidadPosterior() { return false; }
   // The same, into the resolved depth texture at base_textura (a draw's sampled texture address) instead of the last
   // depth resolve: a later resolve of another depth target (a shadow map after the scene depth) does not redirect it.
-  // Once per resolve of that texture. Returns kFusion*.
+  // Once per resolve of that texture, and again whenever its depth target was fully cleared after the resolve and has
+  // been drawn on since the last merge. solo_tras_borrado: only in that second case (the target is another pass's
+  // depth now, such as the first-person weapon's); otherwise kFusionNoEsZ. Returns kFusion*.
   static constexpr int kFusionHecha = 1, kFusionNoEsZ = 0, kFusionYaHecha = 2, kFusionSinDestino = -1,
                        kFusionSinTextura = -2, kFusionRectangulo = -3, kFusionCopiaFallo = -4;
-  virtual int FusionarProfundidadEn(uint32_t base_textura) { (void)base_textura; return kFusionNoEsZ; }
+  virtual int FusionarProfundidadEn(uint32_t base_textura, bool solo_tras_borrado = false) {
+    (void)base_textura;
+    (void)solo_tras_borrado;
+    return kFusionNoEsZ;
+  }
   // The texture address of the last depth resolve done by copying (what FusionarProfundidadPosterior uses), 0 if none.
   virtual uint32_t UltimaResolucionProfundidad() const { return 0; }
   // Preloads the given shaders into the backend (DKSH cache / GPU preparation).
diff --git a/src/x360/deko/destinos.cpp b/src/x360/deko/destinos.cpp
index 76d61d5..cc9228b 100644
--- a/src/x360/deko/destinos.cpp
+++ b/src/x360/deko/destinos.cpp
@@ -1448,6 +1448,16 @@ void RenderDk::BorrarProfundidad(const RegistrosCopia& reg, uint32_t pitch) {
   // remembered, Singularity's full depth clear right after it (same value, no draw between) was skipped as a repeat,
   // the first-person weapon was drawn against the world's depth and world objects in front of it cut it away.
   previo = solo_estencil ? EstadoBorrado{} : EstadoBorrado{reg.rb_depth_clear, dibujados_};
+  if (!solo_estencil) {
+    // A full clear after a resolve of this target: what is drawn on it next (the first-person weapon) is not in the
+    // resolved texture, and FusionarProfundidadEn(base, true) may bring it in.
+    // A clear after a merge is the next frame's (its resolve renews the entry): the texture is not followed any more.
+    for (auto& [base_z, z] : z_resueltas_) {
+      if ((z.info & 0x1FFFF) == (info & 0x1FFFF) && z.pitch == pitch) {
+        z.borrada = !(z.borrada && z.dibujos_fusion != UINT64_MAX);
+      }
+    }
+  }
   ++borrados_profundidad_;
   profundidad->borrado_solo_estencil =
       solo_estencil && (!profundidad->borrado_pendiente || profundidad->borrado_solo_estencil);
@@ -1719,16 +1729,19 @@ bool RenderDk::FusionarProfundidadPosterior() {
   return FusionarDesde(ultima_z_info_, ultima_z_pitch_, ultima_z_textura_, ultima_z_rect_, motivo);
 }
 
-int RenderDk::FusionarProfundidadEn(uint32_t base_textura) {
+int RenderDk::FusionarProfundidadEn(uint32_t base_textura, bool solo_tras_borrado) {
   base_textura &= 0x1FFFFFFF;
   const auto it = z_resueltas_.find(base_textura);
-  if (it == z_resueltas_.end()) {
+  if (it == z_resueltas_.end() || (solo_tras_borrado && !it->second.borrada)) {
     return kFusionNoEsZ;
   }
-  if (!it->second.pendiente) {
+  // Again only if something was drawn since the last merge (merging keeps the nearer depth: repeating it is harmless).
+  const bool otra_vez = it->second.borrada && it->second.dibujos_fusion != dibujados_;
+  if (!it->second.pendiente && !otra_vez) {
     return kFusionYaHecha;
   }
   it->second.pendiente = false;  // once per resolve
+  it->second.dibujos_fusion = dibujados_;
   if (ultima_z_valida_ && ultima_z_textura_ == base_textura) {
     ultima_z_valida_ = false;  // the same merge as FusionarProfundidadPosterior's
   }
-- 
2.43.0

